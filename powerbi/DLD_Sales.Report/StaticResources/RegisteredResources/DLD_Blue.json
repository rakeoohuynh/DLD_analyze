{
  "name": "DLD Blue",
  "dataColors": [
    "#1F5FAD",
    "#5DA9E9",
    "#0B2A55",
    "#9CC8F0",
    "#2E86C1",
    "#7FA7D6",
    "#16467F",
    "#B9D9F5",
    "#3F7FBF",
    "#0E3A70"
  ],
  "foreground": "#14233C",
  "foregroundNeutralSecondary": "#5B6B82",
  "foregroundNeutralTertiary": "#8A99AD",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F8FC",
  "backgroundNeutral": "#D9E3EF",
  "tableAccent": "#1F5FAD",
  "good": "#1E8E5A",
  "bad": "#C0392B",
  "neutral": "#D9A400",
  "maximum": "#0B2A55",
  "center": "#5DA9E9",
  "minimum": "#D6E6F7",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0B2A55"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#14233C"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#0B2A55"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#0B2A55"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0B2A55"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D9E3EF"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight",
            "transparency": 85
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 12,
            "right": 12
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#E6ECF3"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF3F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EEF3F9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "categoryLabels": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0B2A55"
              }
            },
            "fontSize": 24,
            "labelDisplayUnits": 1
          }
        ],
        "title": [
          {
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#5B6B82"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "data": [
          {
            "mode": "Dropdown"
          }
        ],
        "header": [
          {
            "show": false
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#14233C"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 10
          }
        ],
        "title": [
          {
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#5B6B82"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ],
        "padding": [
          {
            "top": 4,
            "bottom": 4,
            "left": 10,
            "right": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0B2A55"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 4,
            "left": 20,
            "right": 20
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#14233C"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "categoryLabels": [
          {
            "show": false
          }
        ],
        "bubbles": [
          {
            "bubbleSize": -5
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#0B2A55"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#14233C"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#14233C"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F3F7FC"
              }
            },
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#D9E3EF"
              }
            },
            "rowPadding": 4
          }
        ],
        "total": [
          {
            "backColor": {
              "solid": {
                "color": "#D6E6F7"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#0B2A55"
              }
            }
          }
        ]
      }
    }
  }
}