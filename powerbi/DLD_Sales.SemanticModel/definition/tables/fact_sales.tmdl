		lineageTag: e580dde5-def5-4ab1-9d72-0afc6430ed4a
		summarizeBy: sum
		sourceColumn: price_aed

		annotation SummarizationSetBy = Automatic

	column area_sqm
		dataType: double
		formatString: #,0.00
		lineageTag: 191eec0b-5b1f-4b5e-8eb5-709c8eba6fa3
		summarizeBy: sum
		sourceColumn: area_sqm

		annotation SummarizationSetBy = Automatic

	column price_psf
		dataType: double
		formatString: #,0.00
		lineageTag: 41c89a53-37aa-4d50-8434-041b8f25bf13
