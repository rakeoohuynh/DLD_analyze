		sourceColumn: price_psf

		annotation SummarizationSetBy = Automatic

	partition fact_sales = m
		mode: import
		source = Table.TransformColumnTypes(Table.SelectColumns(GetTable("fact_sales"), {"transaction_id", "date_id", "area_id", "project_id", "property_id", "procedure_id", "price_aed", "area_sqm", "price_psf"}), {{"transaction_id", type text}, {"date_id", Int64.Type}, {"area_id", Int64.Type}, {"project_id", Int64.Type}, {"property_id", Int64.Type}, {"procedure_id", Int64.Type}, {"price_aed", Int64.Type}, {"area_sqm", type number}, {"price_psf", type number}})

	annotation PBI_ResultType = Table

